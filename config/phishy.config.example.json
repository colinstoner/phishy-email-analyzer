{
  "ai": {
    "provider": "anthropic",
    "anthropic": {
      "apiKey": "sk-ant-your-api-key-here",
      "model": "claude-opus-5-5",
      "maxTokens": 16000,
      "timeout": 60000
    },
    "bedrock": {
      "region": "us-east-1",
      "modelId": "global.anthropic.claude-opus-5-5",
      "maxTokens": 16000,
      "timeout": 60000
    },
    "effort": "medium",
    "refusalFallbackModel": "claude-opus-4-8",
    "fallbackProvider": "bedrock"
  },
  "email": {
    "safeDomains": ["yourcompany.com", "example.com"],
    "safeSenders": ["security@yourcompany.com"],
    "deleteAfterProcessing": false
  },
  "notification": {
    "senderEmail": "phishy@yourcompany.com",
    "senderName": "Phishy Security",
    "securityTeamDistribution": ["security-team@yourcompany.com"],
    "sesConfigSet": "phishy-config-set"
  },
  "storage": {
    "s3Bucket": "phishy-emails",
    "s3Prefix": "emails",
    "region": "us-east-1"
  },
  "intelligence": {
    "enabled": true,
    "type": "postgres",
    "connectionString": "postgresql://user:password@localhost:5432/phishy"
  },
  "campaignAlerts": {
    "enabled": false,
    "distributionList": "all-staff@yourcompany.com"
  },
  "campaignResponse": {
    "enabled": false,
    "audience": "distribution",
    "employeeWarning": "approve",
    "distributionWarning": "auto",
    "approvalTtlHours": 4,
    "maxWarningsPerCampaign": 100,
    "maxRemovalMailboxes": 500,
    "maxRemovalMessages": 1000,
    "updateIntervalMinutes": 30,
    "alreadyClickedInstructions": "If you clicked a link in it, opened an attachment, or entered your password, contact your IT or security team straight away and change your password. You will not be in trouble: reporting it quickly is what limits the damage.",
    "timeZone": "UTC"
  },
  "campaignCache": {
    "enabled": false,
    "ttlHours": 24
  },
  "agentic": {
    "enabled": false,
    "maxToolRounds": 5
  },
  "commands": {
    "enabled": false
  },
  "graph": {
    "enabled": false,
    "mode": "direct",
    "brokerFunctionName": "phishy-graph-broker",
    "tenantId": "00000000-0000-0000-0000-000000000000",
    "read": {
      "clientId": "11111111-1111-1111-1111-111111111111",
      "certificate": "arn:aws:secretsmanager:us-east-1:123456789012:secret:phishy/graph-read-AbCdEf"
    },
    "originalFetch": {
      "enabled": false
    },
    "blastRadius": {
      "enabled": false,
      "timeBudgetMs": 45000,
      "maxMailboxes": 2000
    },
    "senderHistory": {
      "enabled": false,
      "lookbackDays": 30,
      "burstWindowHours": 24,
      "budgetMs": 8000,
      "fanoutMinRecipients": 15,
      "fanoutMultiplier": 3
    }
  },
  "reportButton": {
    "enabled": false
  },
  "logLevel": "info"
