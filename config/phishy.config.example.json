{
  "ai": {
    "provider": "anthropic",
    "anthropic": {
      "apiKey": "sk-ant-your-api-key-here",
      "model": "claude-opus-4-8",
      "maxTokens": 4096,
      "timeout": 60000
    },
    "bedrock": {
      "region": "us-east-1",
      "modelId": "global.anthropic.claude-opus-4-8",
      "maxTokens": 4096,
      "timeout": 60000
    },
    "fallbackProvider": "bedrock"
  },
  "email": {
    "safeDomains": ["yourcompany.com", "example.com"],
    "safeSenders": ["security@yourcompany.com"],
    "deleteAfterProcessing": false
  },
  "notification": {
    "senderEmail": "phishy@yourcompany.com",
    "senderName": "Phishy Security",
    "securityTeamDistribution": ["security-team@yourcompany.com"],
    "sesConfigSet": "phishy-config-set"
  },
  "storage": {
    "s3Bucket": "phishy-emails",
    "s3Prefix": "emails",
    "region": "us-east-1"
  },
  "intelligence": {
    "enabled": true,
    "type": "postgres",
    "connectionString": "postgresql://user:password@localhost:5432/phishy"
  },
  "campaignCache": {
    "enabled": false,
    "ttlHours": 24
  },
  "agentic": {
    "enabled": false,
    "maxToolRounds": 5
  },
  "commands": {
    "enabled": false
  },
  "graph": {
    "enabled": false,
    "tenantId": "00000000-0000-0000-0000-000000000000",
    "read": {
      "clientId": "11111111-1111-1111-1111-111111111111",
      "certificate": "arn:aws:secretsmanager:us-east-1:123456789012:secret:phishy/graph-read-AbCdEf"
    },
    "blastRadius": {
      "enabled": false,
      "timeBudgetMs": 45000,
      "maxMailboxes": 2000
    }
  },
  "logLevel": "info"
}
