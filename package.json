{
  "name": "phishy-email-analyzer",
  "version": "3.0.0",
  "description": "Open-source phishing response for your organization: employees report a suspicious email, Claude analyzes it and replies in plain language; optional threat intelligence, campaign response and read-only Microsoft Graph lookups, on AWS Lambda",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "phishy-try": "dist/cli/try.js",
    "phishy-graph-probe": "dist/cli/graph-probe.js"
  },
  "scripts": {
    "try": "npm run build && node dist/cli/try.js",
    "graph:probe": "npm run --silent build && node dist/cli/graph-probe.js",
    "indicators:audit": "esbuild src/cli/indicator-audit.ts --bundle --platform=node --target=node22 --loader:.pem=text --log-level=warning --outfile=dist/cli-bundles/indicator-audit.cjs && node dist/cli-bundles/indicator-audit.cjs",
    "eval:injection": "esbuild src/cli/injection-eval.ts --bundle --platform=node --target=node22 --loader:.pem=text --log-level=warning --outfile=dist/eval/injection-eval.cjs && node dist/eval/injection-eval.cjs",
    "build": "tsc",
    "postbuild": "node scripts/build-pem-modules.js",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package-lambda.js",
    "deploy": "node scripts/package-lambda.js --deploy"
  },
  "keywords": [
    "security",
    "phishing",
    "email",
    "analysis",
    "claude",
    "aws",
    "lambda",
    "bedrock",
    "ses",
    "anthropic",
    "threat-intelligence",
    "microsoft-graph",
    "incident-response",
    "prompt-injection"
  ],
  "author": "Colin Stoner <colinstoner@gmail.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1173.0",
    "@aws-sdk/client-lambda": "^3.1173.0",
    "@aws-sdk/client-rds-data": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/client-secrets-manager": "^3.1173.0",
    "@aws-sdk/client-ses": "^3.1173.0",
    "axios": "^1.21.1",
    "mailparser": "3.14.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smithy/util-stream": "^4.8.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/colinstoner/phishy-email-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/colinstoner/phishy-email-analyzer/issues"
  },
  "homepage": "https://github.com/colinstoner/phishy-email-analyzer#readme"
}
